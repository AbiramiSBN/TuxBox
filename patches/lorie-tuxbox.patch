diff --git a/lorie/src/main/java/com/termux/x11/input/GamepadMouse.java b/lorie/src/main/java/com/termux/x11/input/GamepadMouse.java
new file mode 100644
index 0000000..5b3f716
--- /dev/null
+++ b/lorie/src/main/java/com/termux/x11/input/GamepadMouse.java
@@ -0,0 +1,134 @@
+package com.termux.x11.input;
+
+import android.os.Handler;
+import android.os.Looper;
+import android.view.InputDevice;
+import android.view.KeyEvent;
+import android.view.MotionEvent;
+
+import com.termux.x11.LorieView;
+import com.termux.x11.MainActivity;
+
+/**
+ * TuxBox addition: use a game controller as mouse + keyboard on the X desktop.
+ *
+ *  Left stick: mouse (relative)   Right stick: scroll   D-pad: arrow keys
+ *  A: left click (hold to drag)   B: right click        L3: middle click
+ *  X: Enter   Y: Backspace   Select: Esc   Start: on-screen keyboard
+ *  L1: Super (hold)   R1: Alt (hold)   L2: Ctrl (hold)   R2: Tab   R3: extra keys bar
+ */
+public class GamepadMouse {
+    private final MainActivity activity;
+    private final Handler handler = new Handler(Looper.getMainLooper());
+    private float lx, ly, rx, ry, scrollAccX, scrollAccY;
+    private int hatX, hatY;
+    private boolean l2, r2, ticking;
+
+    public GamepadMouse(MainActivity activity) { this.activity = activity; }
+
+    private LorieView view() { return activity.getLorieView(); }
+
+    private static float dead(float v) { return Math.abs(v) < 0.15f ? 0f : v; }
+
+    /** Returns true if the event was a controller event and has been consumed. */
+    public boolean onMotion(MotionEvent e) {
+        if (!e.isFromSource(InputDevice.SOURCE_JOYSTICK) || e.getActionMasked() != MotionEvent.ACTION_MOVE)
+            return false;
+        lx = dead(e.getAxisValue(MotionEvent.AXIS_X));
+        ly = dead(e.getAxisValue(MotionEvent.AXIS_Y));
+        rx = dead(e.getAxisValue(MotionEvent.AXIS_Z));
+        ry = dead(e.getAxisValue(MotionEvent.AXIS_RZ));
+
+        int hx = axisToDir(e.getAxisValue(MotionEvent.AXIS_HAT_X));
+        int hy = axisToDir(e.getAxisValue(MotionEvent.AXIS_HAT_Y));
+        if (hx != hatX) {
+            if (hatX != 0) key(hatX < 0 ? KeyEvent.KEYCODE_DPAD_LEFT : KeyEvent.KEYCODE_DPAD_RIGHT, false);
+            if (hx != 0) key(hx < 0 ? KeyEvent.KEYCODE_DPAD_LEFT : KeyEvent.KEYCODE_DPAD_RIGHT, true);
+            hatX = hx;
+        }
+        if (hy != hatY) {
+            if (hatY != 0) key(hatY < 0 ? KeyEvent.KEYCODE_DPAD_UP : KeyEvent.KEYCODE_DPAD_DOWN, false);
+            if (hy != 0) key(hy < 0 ? KeyEvent.KEYCODE_DPAD_UP : KeyEvent.KEYCODE_DPAD_DOWN, true);
+            hatY = hy;
+        }
+
+        boolean lt = Math.max(e.getAxisValue(MotionEvent.AXIS_LTRIGGER), e.getAxisValue(MotionEvent.AXIS_BRAKE)) > 0.5f;
+        boolean rt = Math.max(e.getAxisValue(MotionEvent.AXIS_RTRIGGER), e.getAxisValue(MotionEvent.AXIS_GAS)) > 0.5f;
+        if (lt != l2) button(KeyEvent.KEYCODE_BUTTON_L2, lt);
+        if (rt != r2) button(KeyEvent.KEYCODE_BUTTON_R2, rt);
+
+        if (!ticking && (lx != 0 || ly != 0 || rx != 0 || ry != 0)) {
+            ticking = true;
+            handler.post(tick);
+        }
+        return true;
+    }
+
+    private static int axisToDir(float v) { return v > 0.5f ? 1 : (v < -0.5f ? -1 : 0); }
+
+    private final Runnable tick = new Runnable() {
+        @Override public void run() {
+            if (lx == 0 && ly == 0 && rx == 0 && ry == 0) { ticking = false; return; }
+            LorieView v = view();
+            if (v != null && v.connected()) {
+                if (lx != 0 || ly != 0) {
+                    float speed = 22f * activity.getResources().getDisplayMetrics().density / 2f;
+                    v.sendMouseEvent(lx * Math.abs(lx) * speed, ly * Math.abs(ly) * speed, InputStub.BUTTON_UNDEFINED, false, true);
+                }
+                scrollAccX += rx * 0.3f;
+                scrollAccY += ry * 0.3f;
+                if (Math.abs(scrollAccX) >= 1f || Math.abs(scrollAccY) >= 1f) {
+                    int sx = (int) scrollAccX, sy = (int) scrollAccY;
+                    v.sendMouseWheelEvent(sx * 100f, sy * 100f);
+                    scrollAccX -= sx; scrollAccY -= sy;
+                }
+            }
+            handler.postDelayed(this, 16);
+        }
+    };
+
+    /** Returns true if the key event came from a controller button and has been consumed. */
+    public boolean onKey(KeyEvent e) {
+        int code = e.getKeyCode();
+        boolean padButton = KeyEvent.isGamepadButton(code);
+        boolean padDpad = e.isFromSource(InputDevice.SOURCE_GAMEPAD) && code >= KeyEvent.KEYCODE_DPAD_UP && code <= KeyEvent.KEYCODE_DPAD_CENTER;
+        if (!padButton && !padDpad) return false;
+        if (e.getAction() == KeyEvent.ACTION_MULTIPLE) return true;
+        boolean down = e.getAction() == KeyEvent.ACTION_DOWN;
+        if (padDpad) {
+            if (e.getRepeatCount() == 0)
+                key(code == KeyEvent.KEYCODE_DPAD_CENTER ? KeyEvent.KEYCODE_ENTER : code, down);
+            return true;
+        }
+        if (e.getRepeatCount() == 0) button(code, down);
+        return true;
+    }
+
+    private void mouse(int b, boolean down) {
+        LorieView v = view();
+        if (v != null && v.connected()) v.sendMouseEvent(0, 0, b, down, true);
+    }
+
+    private void key(int keyCode, boolean down) {
+        LorieView v = view();
+        if (v != null && v.connected()) v.sendKeyEvent(0, keyCode, down);
+    }
+
+    private void button(int code, boolean down) {
+        switch (code) {
+            case KeyEvent.KEYCODE_BUTTON_A: mouse(InputStub.BUTTON_LEFT, down); break;
+            case KeyEvent.KEYCODE_BUTTON_B: mouse(InputStub.BUTTON_RIGHT, down); break;
+            case KeyEvent.KEYCODE_BUTTON_THUMBL: mouse(InputStub.BUTTON_MIDDLE, down); break;
+            case KeyEvent.KEYCODE_BUTTON_X: key(KeyEvent.KEYCODE_ENTER, down); break;
+            case KeyEvent.KEYCODE_BUTTON_Y: key(KeyEvent.KEYCODE_DEL, down); break;
+            case KeyEvent.KEYCODE_BUTTON_SELECT: key(KeyEvent.KEYCODE_ESCAPE, down); break;
+            case KeyEvent.KEYCODE_BUTTON_START: if (down) activity.toggleKeyboardVisibility(); break;
+            case KeyEvent.KEYCODE_BUTTON_L1: key(KeyEvent.KEYCODE_META_LEFT, down); break;
+            case KeyEvent.KEYCODE_BUTTON_R1: key(KeyEvent.KEYCODE_ALT_LEFT, down); break;
+            case KeyEvent.KEYCODE_BUTTON_L2: if (down != l2) { l2 = down; key(KeyEvent.KEYCODE_CTRL_LEFT, down); } break;
+            case KeyEvent.KEYCODE_BUTTON_R2: if (down != r2) { r2 = down; key(KeyEvent.KEYCODE_TAB, down); } break;
+            case KeyEvent.KEYCODE_BUTTON_THUMBR: if (down) activity.toggleExtraKeys(); break;
+            default: break;
+        }
+    }
+}
