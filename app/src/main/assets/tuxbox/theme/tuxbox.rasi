/* TuxBox launcher: white pill style matching Simple-White */
configuration {
    show-icons: true;
    icon-theme: "Papirus";
    drun-display-format: "{name}";
    display-drun: "󰍉";
    display-window: "󰕮";
}
* {
    bg: #F2FFFFFF;
    fg: #1f2329;
    dim: #8a8f98;
    sel: #1f2329;
    font: "JetBrainsMono Nerd Font Bold 10";
    background-color: transparent;
    text-color: @fg;
}
window {
    width: 44%;
    background-color: @bg;
    border: 1px;
    border-color: #14000000;
    border-radius: 14px;
    padding: 16px;
}
mainbox { children: [ inputbar, listview ]; spacing: 14px; }
inputbar {
    background-color: #0F000000;
    border-radius: 10px;
    padding: 8px 12px;
    spacing: 8px;
    children: [ prompt, entry ];
}
entry { placeholder: "Search apps"; placeholder-color: @dim; }
listview { columns: 5; lines: 3; spacing: 8px; fixed-height: true; scrollbar: false; }
element { orientation: vertical; padding: 10px 6px; border-radius: 12px; spacing: 6px; }
element selected { background-color: @sel; text-color: #FFFFFF; }
element-icon { size: 42px; horizontal-align: 0.5; }
element-text { horizontal-align: 0.5; text-color: inherit; }
