# TuxBox Hypr-style compositor: rounded, translucent, blurred windows (Hyprland look)
corner-radius = 10;
round-borders = 1;
rounded-corners-exclude = [ "class_g = 'Polybar'", "window_type = 'dock'", "window_type = 'desktop'" ];

shadow = true;
shadow-radius = 10;
shadow-opacity = 0.28;
shadow-offset-x = -8;
shadow-offset-y = -8;
shadow-exclude = [ "class_g = 'Polybar'", "window_type = 'dock'", "_GTK_FRAME_EXTENTS@:c" ];

fading = true;
fade-in-step = 0.05;
fade-out-step = 0.05;

active-opacity = @ACTIVE@;
inactive-opacity = @INACTIVE@;
opacity-rule = [ "100:fullscreen", "100:class_g = 'Rofi'", "100:class_g = 'Polybar'",
                 "100:class_g = 'firefox'", "100:class_g = 'firefox-esr'" ];

blur-method = "dual_kawase";
blur-strength = 6;
blur-background-exclude = [ "window_type = 'desktop'", "_GTK_FRAME_EXTENTS@:c" ];

vsync = true;
use-damage = true;
detect-client-opacity = true;

animations = (
  { triggers = ["open", "show"]; preset = "appear"; duration = 0.22; scale = 0.9; },
  { triggers = ["close", "hide"]; preset = "disappear"; duration = 0.16; scale = 0.9; },
  { triggers = ["geometry"]; preset = "geometry-change"; duration = 0.22; }
);
