<?xml version="1.0" encoding="utf-8"?>
<!-- 320x180 Android TV launcher banner -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#1B2B3A" android:endColor="#0E6E5C" android:angle="0" />
            <size android:width="320dp" android:height="180dp" />
        </shape>
    </item>
    <item android:gravity="center" android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
